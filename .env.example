# Names only. Real values live in Vercel (server) or are inlined at build time (EXPO_PUBLIC_*).
# NEVER commit real secret values.

# --- Server (Vercel project "exengrupo") ---
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the key with literal "\n"; the server converts them to newlines.
GOOGLE_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SESSION_SECRET=
CRON_SECRET=
# Password for the hidden admin panel (tap the "exengrupo" title 7 times)
ADMIN_PASSWORD=
# Optional: Claude (Anthropic). Can also be added in the admin panel (Claves IA).
ANTHROPIC_API_KEY=

# Optional: AI model IDs (defaults in server/ai/providers.ts → DEFAULT_MODELS); the admin panel can override them
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_MODEL=google/gemma-3-27b-it:free

# --- Client (public, inlined at build time) ---
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
