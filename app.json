{
  "expo": {
    "name": "exengrupo",
    "slug": "exengrupo",
    "version": "1.0.0",
    "scheme": "exengrupo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.exengrupo.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "exengrupo.vercel.app",
              "pathPrefix": "/unirse"
            },
            {
              "scheme": "https",
              "host": "exengrupo.vercel.app",
              "pathPrefix": "/activar"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "exengrupo",
      "shortName": "exengrupo",
      "lang": "es",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": false,
          "granularPermissions": ["photo"]
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
